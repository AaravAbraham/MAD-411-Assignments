<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.androidassignment7">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidAssignment7">

        <!-- MainActivity (the entry point of the app) -->
        <activity
            android:name=".MainActivity"
            android:label="Main Activity"
            android:theme="@style/Theme.AppCompat.Light.DarkActionBar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ExpenseActivity (details screen for an expense) -->
        <activity
            android:name=".ExpenseActivity"
            android:label="Expense Details"
            android:theme="@style/Theme.AppCompat.Light.DarkActionBar">
        </activity>

    </application>

</manifest>
